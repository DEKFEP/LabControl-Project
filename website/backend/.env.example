# LabControl 4.2 — Variables de entorno (plantilla de referencia)
# ------------------------------------------------------------------------------
# El backend NO carga automáticamente un archivo .env: define estas variables en
# el panel del hosting (Railway > servicio > Variables). Este archivo es solo una
# plantilla; NO contiene secretos reales. Copia lo que necesites y usa secretos
# propios y aleatorios. Nunca subas un .env real al repositorio.

# --- Servidor ---
PORT=3000                 # Puerto HTTP. Railway lo inyecta solo; normalmente no tocar.
LC_PUBLIC_DIR=            # Carpeta de archivos estáticos. Por defecto: ../public.
LC_DB_DIR=                # Carpeta del volumen con la base SQLite (*.db). Obligatoria en producción.

# --- Datos iniciales ---
LC_SEED_DEMO=             # "1" carga la semilla de ejemplo (cuentas INSUCO/prof_* con contraseñas
                          # conocidas, reservas y reportes). Solo para desarrollo. Por defecto: desactivada.
LC_ADMIN_USER=            # Usuario del administrador para instalaciones sin semilla (por defecto: INSUCO).
LC_ADMIN_PASSWORD=        # Contraseña del administrador. Obligatoria para crearlo; nunca subir al repo.
LC_ADMIN_EMAIL=           # Correo del administrador (por defecto: admin@liceo.cl).
LC_REGISTRO_DOMINIOS=     # Dominios de correo admitidos en el registro público, separados por coma
                          # (p. ej. "liceo.cl,insuco.cl"). Sin esta variable el registro nace CERRADO.
                          # Aunque el dominio esté admitido, la cuenta queda pendiente hasta que un
                          # administrador la apruebe desde Usuarios.

# --- Seguridad / sesión ---
JWT_SECRET=               # Firma de los tokens. Obligatoria en producción (cadena larga y aleatoria).
LC_JWT_EXPIRES=           # Duración del token de acceso (ej. 30m). Por defecto: 30 min (rango 5 min - 2 h).
LC_TRUST_PROXY=           # Número de saltos de proxy de confianza (ej. 1). Opcional.
LC_PROXY_SECRET=          # Secreto compartido con la Pages Function para anclar la IP real.
                          # Debe ser EL MISMO valor aquí y en el proyecto de Cloudflare Pages.
LC_SALUD_TOKEN=           # Token para que /api/salud revele la versión (anti-fingerprinting).
                          # Debe coincidir con el secreto LC_SALUD_TOKEN del despliegue.
LC_PUBLIC_URL=            # URL pública https del sitio (ej. https://micentro.pages.dev). Habilita las
                          # cookies Secure y arma el enlace de recuperación de contraseña.
ORIGIN=                   # Orígenes CORS permitidos, separados por coma. Por defecto: ninguno (false).

# --- Límites de peticiones por minuto (opcionales; valores por defecto) ---
LC_API_LIMIT=200
LC_ESCRITURA_LIMIT=60
LC_LOGIN_LIMIT=10
LC_REGISTRO_LIMIT=10
LC_RESET_LIMIT=5
LC_SENSIBLES_LIMIT=10

# --- Correo (recuperación de contraseña con Resend) ---
RESEND_API_KEY=           # Clave de API de Resend. Sin ella, el enlace se imprime en consola (solo desarrollo).
RESEND_FROM=              # Remitente. Por defecto: LabControl <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# Variables del proyecto de Cloudflare Pages (se definen en el panel de Pages,
# NO en este archivo):
#   API_ORIGIN        URL pública del backend en Railway (sin barra final).
#   LC_PROXY_SECRET   Mismo valor que el del backend (ver arriba).
